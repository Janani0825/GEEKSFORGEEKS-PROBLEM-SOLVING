import java.util.Arrays;
class Solution {
    public int countSubarray(int[] arr, int l, int r) {
        int countR = countSubarraysWithSumLessThanOrEqualTo(arr, r);
        int countLMinus1 = countSubarraysWithSumLessThanOrEqualTo(arr, l - 1);
        return countR - countLMinus1;
    }
    private int countSubarraysWithSumLessThanOrEqualTo(int[] arr, int target) {
        if (target < 0) return 0;
        int count = 0;
        int currentSum = 0;
        int left = 0;
        for (int right = 0; right < arr.length; right++) {
            currentSum += arr[right];
            while (currentSum > target && left <= right) {
                currentSum -= arr[left];
                left++;
            }
            count += (right - left + 1);
        }
        
        return count;
    }
}
