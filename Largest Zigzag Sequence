class Solution {
    public int zigzagSequence(int[][] mat) {
        int n = mat.length;
        if (n == 0) return 0;
        
        int[] prevRow = new int[n];
        for (int j = 0; j < n; j++) {
            prevRow[j] = mat[0][j];
        }
        for (int i = 1; i < n; i++) {
        int[] currRow = new int[n];
        int max1 = Integer.MIN_VALUE, max2 = Integer.MIN_VALUE;
        int max1Col = -1;
            
        for (int j = 0; j < n; j++) {
            if (prevRow[j] > max1) {
                max2 = max1;
                max1 = prevRow[j];
                max1Col = j;
            } 
            else if (prevRow[j] > max2) {
               max2 = prevRow[j];
                }
            }
            for (int j = 0; j < n; j++) {
                if (j == max1Col) {
                    currRow[j] = mat[i][j] + max2;
                } else {
                    currRow[j] = mat[i][j] + max1;
                }
            }
            prevRow = currRow;
        }
        int maxZigzagSum = Integer.MIN_VALUE;
        for (int j = 0; j < n; j++) {
            maxZigzagSum = Math.max(maxZigzagSum, prevRow[j]);
        }
        
        return maxZigzagSum;
    }
}

        
